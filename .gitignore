# Claude Code local settings
.claude/settings.local.json

# 비밀 설정(자격 증명) — 소스/원격에 커밋 금지. 각 환경에서 직접 생성.
# 형식: master_config.json={ "id": "...", "password": "..." }
#       firebase_config.json={ "apiKey": "...", "projectId": "...", "googleWebClientId": "..." }
/[Aa]ssets/[Rr]esources/master_config.json
/[Aa]ssets/[Rr]esources/master_config.json.meta
/[Aa]ssets/[Rr]esources/firebase_config.json
/[Aa]ssets/[Rr]esources/firebase_config.json.meta
/[Aa]ssets/google-services.json
/[Aa]ssets/google-services.json.meta

# Duplicate Unity project
/[Mm]y [Pp]roject/

# Firebase Functions generated/local files
/functions/node_modules/
/functions/.runtimeconfig.json
/firebase-debug.log
/firestore-debug.log
/.codex/tools/

# 에셋 백업 사본 — Resources 내 스테일 .bak이 커밋/로드 대상과 혼동되지 않게
*.bak
*.bak.meta

# Python 캐시 — .claude/.codex 훅·스크립트 실행 시 생성
__pycache__/
*.pyc

# 카카오톡으로 주고받은 기기 테스트 스크린샷 — 저장소에 둘 이유 없음
KakaoTalk_*.jpg
KakaoTalk_*.png

# 임시 작업 디렉토리
/.utmp/

# Codex 미러 실행 로그
/.codex/*.log
