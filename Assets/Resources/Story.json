    {
      "beatId": "ch1_guardian_win",
      "chapterId": "ch1",
      "order": 6,
      "prerequisiteBeatId": "ch1_guardian_call",
      "trigger": { "type": "QuestComplete", "param": "q_guardian1" },
      "speakerNpcId": "village_elder",
      "lines": [
        { "speaker": "마을 어르신", "text": "해냈구나! 수문장이 길을 열어 주었어. 이제 초원 너머로 갈 수 있단다." },
        { "speaker": "마을 어르신", "text": "그런데… 쓰러진 그 아이가 마지막에 남긴 떨림이, 저 먼 유적 쪽을 향하고 있었어. 우연이 아닐 게다." },
        { "speaker": "마을 어르신", "text": "사라짐의 뿌리가 정말 그곳이라면, 네 여행은 이제 시작인 셈이야. 연못과 꽃밭, 두 갈래 길이 열렸단다." }
      ],
