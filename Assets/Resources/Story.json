      "prerequisiteBeatId": "ch1_reach_pond",
      "trigger": { "type": "RegionEnter", "param": "forest" },
      "speakerNpcId": "ruins_scholar",
      "lines": [
        { "speaker": "세라", "text": "당신이군요. 사라지는 곤충들을 쫓는다는 그 채집가가." },
        { "speaker": "세라", "text": "저는 세라, 고대 유적을 연구하고 있어요. 이 '잦아듦' 현상… 유적의 봉인에 금이 간 것과 결코 무관하지 않아요." },
        { "speaker": "세라", "text": "당신이 모으는 기록 하나하나가, 어쩌면 그 균열을 메우는 열쇠일지도 몰라요." }
      ],
      "choices": [],
