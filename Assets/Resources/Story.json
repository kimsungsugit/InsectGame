      "chapterId": "ch5",
      "order": 11,
      "prerequisiteBeatId": "ch4_reach_swamp",
      "trigger": { "type": "RegionEnter", "param": "mountain" },
      "speakerNpcId": "ruins_scholar",
      "lines": [
        { "speaker": "세라", "text": "산을 오를수록 유적이 가까워져요. 근원이 바로 저 위에 있어요." },
        { "speaker": "세라", "text": "이제 확신해요 — 당신이 곤충을 붙잡아 기록할 때마다, 금 간 봉인이 조금씩 되고정되고 있어요." },
        { "speaker": "세라", "text": "당신의 도감이 곧 이 세계의 버팀목이에요. 조금만 더." }
      ],
      "choices": [],
