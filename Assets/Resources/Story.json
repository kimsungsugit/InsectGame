    {
      "beatId": "ch1_first_capture",
      "chapterId": "ch1",
      "order": 1,
      "prerequisiteBeatId": "ch1_intro",
      "trigger": { "type": "QuestComplete", "param": "q_approach" },
      "speakerNpcId": "village_elder",
      "lines": [
        { "speaker": "마을 어르신", "text": "훌륭해! 첫 곤충을 잡았구나. 네 손끝엔 정말 소질이 있어." },
        { "speaker": "마을 어르신", "text": "그 아이의 모습을 도감에 새겼으니, 이제 쉽게 사라지지 않을 게다. 이게 바로 우리가 할 수 있는 일이란다." },
        { "speaker": "마을 어르신", "text": "예전엔 이 풀밭이 곤충들로 북적였는데… 지금은 너무 조용해. 부디 더 많은 친구들을 기록해 주렴." }
      ],
      "choices": [],
