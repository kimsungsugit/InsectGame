    {
      "beatId": "ch1_guardian_call",
      "chapterId": "ch1",
      "order": 5,
      "prerequisiteBeatId": "ch1_first_battle",
      "trigger": { "type": "QuestComplete", "param": "q_team" },
      "speakerNpcId": "village_elder",
      "lines": [
        { "speaker": "마을 어르신", "text": "혼자선 수문장을 당해내지 못한다. 아끼는 친구들로 팀을 꾸리렴." },
        { "speaker": "마을 어르신", "text": "요즘 그 수문장 사마귀가 몹시 사나워졌어. 곤충들이 사라지는 걸 저도 느끼는 게지… 불안해하는 게야." },
        { "speaker": "마을 어르신", "text": "부디 조심히. 그리고 그 아이도 너무 상하게 하지 않도록." }
      ],
      "choices": [],
      "onComplete": {
