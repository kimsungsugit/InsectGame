    {
      "beatId": "ch1_growth",
      "chapterId": "ch1",
      "order": 3,
      "prerequisiteBeatId": "ch1_rival_intro",
      "trigger": { "type": "QuestComplete", "param": "q_levelup" },
      "speakerNpcId": "village_elder",
      "lines": [
        { "speaker": "마을 어르신", "text": "곤충은 사탕을 먹여 키운단다. 강해진 친구는 더 험한 곳에서도 널 지켜주지." },
        { "speaker": "마을 어르신", "text": "…네가 더 강해져야 할 이유가 있어. 이 모든 사라짐의 뿌리는 저 멀리 고대 유적에 있다는 오랜 이야기가 전해온단다." },
        { "speaker": "마을 어르신", "text": "아직은 먼 이야기야. 지금은 눈앞의 친구들부터 돌보렴." }
      ],
      "choices": [],
      "onComplete": {
